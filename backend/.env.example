# ==============================================================================
# Backend Configuration (.env)
# Sao chép file này thành .env trên máy mới: cp .env.example .env
# ==============================================================================

# 1. Cấu hình kết nối MySQL Database
# Thay password bằng mật khẩu root MySQL của máy bạn
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=fitnessproject;User=root;Password=YOUR_DATABASE_PASSWORD;

# 2. Cấu hình JWT Token
JwtSettings__SecretKey=YOUR_SUPER_SECRET_KEY_FOR_JWT_AUTHENTICATION_AT_LEAST_32_CHARS!
JwtSettings__Issuer=FitnessTrainingSystem
JwtSettings__Audience=FitnessTrainingSystemClient
JwtSettings__ExpiryMinutes=60

# 3. Google OAuth 2.0 (Khớp với Google Cloud Console & Frontend)
GoogleAuth__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# 4. Cấu hình gửi mail OTP qua Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=NETFIT <your_email@gmail.com>
SMTP_ENABLE_SSL=true

# 5. Cấu hình tham số OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5

# 6. Gemini AI API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
Gemini__ApiKey=YOUR_GEMINI_API_KEY

# 7. Cloudinary (Lưu trữ ảnh avatar, bài tập)
Cloudinary__CloudName=YOUR_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=YOUR_CLOUDINARY_API_SECRET

# 8. Groq AI Service (Dinh dưỡng & Bài tập)
GROQ_NUTRITION_API_KEY=YOUR_GROQ_NUTRITION_API_KEY
GROQ_WORKOUT_API_KEY=YOUR_GROQ_WORKOUT_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# 9. PayOS Payment Gateway
PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY
PayOS__ReturnUrl=https://net-fit-rho.vercel.app/#/payment/success
PayOS__CancelUrl=https://net-fit-rho.vercel.app/#/payment/cancel
